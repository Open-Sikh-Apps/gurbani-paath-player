{
  "name": "gurbani-paath-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-sans-gurmukhi": "^0.4.1",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "@shopify/flash-list": "2.0.2",
    "async-mutex": "^0.5.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-crypto": "^57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-navigation-bar": "^57.0.2",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.4.0",
    "lodash": "^4.18.1",
    "nativewind": "^5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-nitro-player": "1.7.0-alpha.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "catalogue:validate": "tsx scripts/validate-catalogue.ts",
    "postinstall": "patch-package && rm -rf node_modules/react-native-nitro-player/android/.cxx",
    "start": "expo start",
    "start:no-dev": "expo start --no-dev --minify",
    "android": "expo run:android",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf ios android node_modules && npm install && npx expo prebuild --clean",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "patch:nitro-player": "rm -rf node_modules/react-native-nitro-player/android/.cxx node_modules/react-native-nitro-player/android/build && patch-package react-native-nitro-player --exclude 'android/\\.cxx|android/build'",
    "cleanup-cmake-error-nitro-player": "rm -rf node_modules/react-native-nitro-player/android/.cxx && rm -rf android/.gradle &&rm -rf ~/.gradle/caches/build-cache-*"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
