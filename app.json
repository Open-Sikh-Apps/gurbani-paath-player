{
  "expo": {
    "name": "Gurbani Paath Player Offline",
    "slug": "gurbani-paath-player",
    "scheme": "gurbanipaath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./src/i18n/native-metadata/en.json",
      "pa": "./src/i18n/native-metadata/pa.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opensikhapps.gurbanipaathplayer",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.opensikhapps.gurbanipaathplayer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "542f5172-9afe-47ed-b04e-4d625c54765e"
      }
    }
  }
}
